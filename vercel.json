{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "//": "schema.sql is read at runtime by the cold-start bootstrap; the bundler only traces require()s, so include it explicitly.",
        "includeFiles": ["server/**"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.+\\.(?:js|css|svg|png|jpg|ico|webp|woff2?|map))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
