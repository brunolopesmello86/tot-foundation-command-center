# T&OT Foundation Command Center — local environment
# Copy to `.env` and fill in. `.env` is git-ignored (see .gitignore).

# Neon Postgres connection string.
# Get it from https://console.neon.tech -> your project -> Connection Details -> Pooled connection
# Looks like: postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Shared passcode that gates the app. Set this before first run — the value is
# hashed and stored in the `settings` table on first migrate.
APP_PASSCODE=

# Secret used to sign session tokens. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Local dev port (ignored on Vercel)
PORT=3000
